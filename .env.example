#############################################
#  VENOM MD BOT - configuration template
#
#  Copy this file to ".env" and fill in your
#  own values. NEVER commit your real .env -
#  it is already listed in .gitignore.
#############################################

#############################################
#  BOT IDENTITY
#############################################
BOT_NAME=VENOM MD BOT
OWNER_NAME=Your Name
# Owner number(s): country code, NO +, NO spaces. Comma separated for multiple owners.
OWNER_NUMBER=2348012345678
# Default command prefix. Use "multi" to accept . / ! # $ , or "none" for no prefix.
PREFIX=.
# Shown in the menu header
USER_TAG=YOUR TAG
BOT_VERSION=v2.0.0
# Namespace for this deploy's data. Blank = your OWNER_NUMBER, which is
# already unique. On the shared built-in cluster each bot gets its own
# database (venom_<BOT_ID>), so no two deploys can overwrite each other.
BOT_ID=
PLATFORM=pterodactyl(panel)

#############################################
#  AUTH / SESSION
#############################################
# qr   -> scan a QR code in the terminal
# pair -> enter an 8 digit pairing code on your phone (best for panels)
AUTH_METHOD=qr
# Number used for pairing code login (only needed when AUTH_METHOD=pair)
PAIR_NUMBER=2348012345678
# Custom 8-char pairing code (A-Z 0-9 only). Leave blank for a random one.
PAIR_CUSTOM_CODE=
# mongo -> session stored in MongoDB (survives Pterodactyl/Heroku redeploys)
# file  -> session stored in the ./session folder
# Paste a session from the generator site to skip QR scanning entirely.
# Get one here: https://session-site-2odn.onrender.com
# (free Render tier - the first load can take ~30s to wake up)
# WARNING: anyone holding this session ID controls the WhatsApp account.
# Never post it publicly or share it. Leave blank to use QR/pairing.
SESSION_ID=

SESSION_STORE=file

#############################################
#  DATABASE
#  Already handled: src/builtin-keys.js ships
#  a working MONGO_URI, so data survives
#  restarts with zero setup. Override below.
#############################################

#############################################
#  KEEP-ALIVE (Render free tier sleeps after 15 min)
#############################################
# true  -> run a tiny HTTP health server. Point UptimeRobot at its URL
#          every 5 minutes so Render never puts the bot to sleep.
# false -> disable (e.g. on Pterodactyl, where it is never needed).
KEEP_ALIVE=true
# Port for the health server. On Render, PORT is set automatically and wins.
# Elsewhere, set KEEP_ALIVE_PORT (default 8000).
KEEP_ALIVE_PORT=8000

#############################################
#  BEHAVIOUR
#############################################
# public  -> everyone can use the bot
# private -> only owner + sudo users
# group   -> only works in groups
# inbox   -> only works in DMs
MODE=public
AUTO_READ=false
AUTO_READ_STATUS=false
AUTO_TYPING=false
ALWAYS_ONLINE=false
REJECT_CALL=false
ANTI_DELETE=true
STARTUP_MESSAGE=true
CMD_REACT=true
# Delete command messages and the bot replies they produce.
# Toggle live from WhatsApp with: .del on | .del off
# The bot must be a group admin to delete another user's command message.
AUTO_DELETE_COMMANDS=false
# Emoji shown the instant a command is accepted. The bot then
# reacts again with the outcome: OK on success, X on failure.
CMD_REACT_EMOJI=⚡
# Chat XP / level system (.rank, .topranks) - on by default.
# Toggle from WhatsApp:  .setvar level_up off

#############################################
#  SUPPORT GROUP GATE (.forcejoin)
#  Users must be members of this group before
#  the bot answers their commands, and anyone
#  who leaves the group is automatically
#  added back. The bot number must be a
#  MEMBER (admin for re-add) of this group.
#  Manage live from WhatsApp: .forcejoin
#############################################
FORCE_JOIN=true
# The moment a non-member runs a command, add them
# into the group automatically and let it run.
FORCE_AUTOADD=true
FORCE_READD=true
SUPPORT_GROUP_LINK=https://chat.whatsapp.com/DYCYPJ602Un8ibZbMAnle7

#############################################
#  DOWNLOADS
#############################################
# How .play / .video fetch from YouTube:
#   auto  (default) public APIs first, yt-dlp as fallback
#   api             APIs only - works on hosts where YouTube blocks the IP
#   ytdlp           local yt-dlp only - best quality, needs a clean IP
# Check what works on your host from WhatsApp with .ytstatus
DL_SOURCE=auto
# Pin one provider (gifted, davidcyril, siputzx, vreden, izumi, ryzendesu)
# or leave blank/auto to try them all in order.
DL_PROVIDER=auto

#############################################
#  DATABASE HOUSEKEEPING
#  Atlas M0 is 512MB and stops accepting
#  writes when full - the bot sweeps spent
#  records every 6h so that never happens.
#  From chat: .dbsize .dbclean .dbkeep
#############################################
# Days of class attendance / AFK history to keep. Balances, roles and
# settings are never deleted by age.
DB_RETAIN_DAYS=90
# false disables the automatic 6-hourly sweep (.dbclean still works).
DB_AUTOCLEAN=true

#############################################
#  VENOM SCHOOL
#  The bot teaches one of its own commands 3x
#  a day in a group, quizzes it, takes a
#  register and tags whoever missed class.
#  Set it up from chat: .school on
#############################################
# The ONE group allowed to hold classes: its invite link, its raw jid, or
# the word "support" to reuse SUPPORT_GROUP_LINK (the force-join group).
# When set, the bot teaches there and nowhere else - no other group gets
# lessons, a register, or AI questions burning your key, and it cannot be
# moved from chat. Blank = no class until the owner sends .school on.
SCHOOL_GROUP=support
# Coins paid for a correct answer (half that for just attending).
SCHOOL_REWARD=100

#############################################
#  AFFILIATE PROGRAMME
#  Users share a code, both sides earn coins,
#  and enough invites promotes them to VIP.
#  Tune live: .setaffiliate <url>, .setvar REF_REWARD 500
#############################################
# Where your affiliate links point. ?ref=CODE is appended, so your host's
# analytics show who sent the traffic. Your repo, deploy page or channel.
AFFILIATE_URL=https://github.com/MykelGoal/VENOM-MD-BOT
# Coins to the inviter per accepted referral.
REF_REWARD=500
# Coins to the newcomer who claims a code.
REF_BONUS=250
# Invites needed before the inviter is auto-promoted to VIP. 0 disables it.
REF_VIP_AT=5

#############################################
#  API KEYS - ALL OPTIONAL.
#
#  You do not have to fill in anything here.
#  Keys that ship with the bot live in
#     src/builtin-keys.js
#  and are used whenever the value below is
#  blank, so a fresh deploy just works.
#  Set one here only to override with your own.
#
#  NOTE: there is deliberately NO YouTube API
#  key here. .play / .video / .spotify use a
#  keyless local downloader (yt-dlp). The
#  YouTube Data API cannot download media, so
#  a key would fix nothing. If .play fails:
#  npm run setup   -> installs the downloader
#  npm run update-dl -> refreshes it
#  cookies.txt     -> clears YouTube bot checks
#  .play auto-falls back to SoundCloud/Audiomack
#  when YouTube refuses; .music <name> searches
#  all three sources directly. See README ->
#  "'.play is not working'".
#############################################
# Without these, AI commands use a free public
# fallback that rate-limits. Add a key for
# reliable results. Check with .aistatus
# ── AI PROVIDERS ────────────────────────────────────────────
# You need NONE of these - the bot falls back to a free keyless
# endpoint. But that rate-limits, so add at least one for a
# proper experience. All of these have real free tiers.
#
# Add them here, or from WhatsApp with:  .setkey groq gsk_xxx
# See every option and signup link with: .aikeys
# Test what is working with:             .aistatus

# Groq - FREE, very generous, fastest of the lot. Best first pick.
#   https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini - FREE tier, highly capable.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cerebras - FREE tier, fastest inference anywhere.
#   https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter - one key, many models, several marked ":free".
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral - free experiment tier.
#   https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Cohere - free trial keys.
#   https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# DeepSeek - paid but extremely cheap, great at code/reasoning.
#   https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI - paid.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenWeather - NOT needed. .weather uses keyless open-meteo.
# Only here for forks that swap the provider.
OPENWEATHER_KEY=

# ── STOCK FOOTAGE for .capcut create mode (BOTH OPTIONAL) ───
# Without either key, ".capcut create ..." still works: it pulls keyless
# stock stills and animates them with Ken Burns motion (zoom/pan per scene).
# Add a key and it upgrades to real moving stock clips instead.
#
# Pexels - free, generous, instant approval.
#   https://www.pexels.com/api/new/
PEXELS_KEY=
# Pixabay - free, instant key on signup.
#   https://pixabay.com/api/docs/
PIXABAY_KEY=

# ── DATABASE ────────────────────────────────────────────────
# Local JSON files in ./data are fine for testing, but most free hosts wipe
# the disk on redeploy, which loses economy balances and group settings -
# so the bot ships with a working MongoDB URI instead.
#
# MongoDB Atlas M0 is free forever and never sleeps:
#   https://cloud.mongodb.com  ->  Create a free M0 cluster
#   Network Access -> allow 0.0.0.0/0 (host IPs are not fixed)
#
# If you leave MONGO_URI blank the bot falls back to the shared cluster in
# src/builtin-keys.js, so your data survives restarts out of the box. That
# cluster is SHARED and PUBLIC - anyone using this repo can read and write
# it. Paste your own URI here for anything private.
#
# Already hosted and want your own database? You do not need this file:
#   .setmongo mongodb+srv://user:pass@cluster.mongodb.net/
# tests it, saves it and switches live - no restart. .getmongo shows the
# active one, .delmongo goes back to the built-in cluster.
MONGO_URI=mongodb+srv://GhostdevM:NaZ4mKNuGYUQg447@cluster0.kfzqn4v.mongodb.net/?appName=Cluster0
MONGO_DB=venom

# Image shown above the .menu text (URL or local path).
# Blank uses the bundled assets/menu.jpg, then your profile picture.
# Change it live with:  .setvar MENU_IMAGE https://i.imgur.com/xxxx.jpg
MENU_IMAGE=
