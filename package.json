{
  "name": "wa-bot",
  "version": "2.0.0",
  "description": "Modular multi-plugin WhatsApp bot built on Baileys v7",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "bot": "node src/main.js",
    "pair": "node index.js --pair",
    "qr": "node index.js --qr",
    "clean": "node -e \"require('fs').rmSync('session',{recursive:true,force:true});console.log('session wiped')\"",
    "setup": "node scripts/setup.js",
    "postinstall": "node scripts/setup.js || echo \"yt-dlp setup skipped - run npm run setup manually\"",
    "update-dl": "node scripts/setup.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "axios": "^1.7.9",
    "baileys": "7.0.0-rc14",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^19.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "jimp": "^1.6.1",
    "mongodb": "^6.12.0",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3"
  },
  "license": "MIT"
}
